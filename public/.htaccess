# The domain's web directory points here. Only this folder is public; the code and .env sit above it.
# The web app (web/dist/, rsynced in) is served at /, the API at /api (docs/web.md §2).
Options +ExecCGI -Indexes
AddHandler cgi-script .cgi
DirectoryIndex index.html

RewriteEngine On

# Pass the Authorization header to CGI (Apache drops it by default). It arrives as
# HTTP_AUTHORIZATION or REDIRECT_HTTP_AUTHORIZATION; oraculoto.api.cgi handles both.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Real files as they are (this also stops the second pass after the rewrites below).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^api/ index.cgi [L]
RewriteRule ^ index.html [L]

# Hashed assets never change; index.html must always be revalidated.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
