# Daily at 09:00 and 23:00 Brasília time, never by weekday: draw days vary (docs/crawler.md §5).
# Persistent: a run missed while the PC was off happens at the next boot.

[Unit]
Description=Oraculoto: crawler schedule

[Timer]
OnCalendar=*-*-* 09,23:00:00 America/Sao_Paulo
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
