# Copy to .env (project root) and adjust. Never commit .env.
# Defaults below match docker-compose.yml (local development).
ORACULOTO_ENV=dev
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=oraculoto
DB_USER=oraculoto
DB_PASSWORD=oraculoto
# Tests wipe this database. Never point it at production.
TEST_DB_NAME=oraculoto_test
# Most target contests one backtest request may score (default 500).
# ORACULOTO_BACKTEST_MAX_CONTESTS=500
# Who signs login tokens: firebase (default; needs FIREBASE_PROJECT_ID) or dev-key (a local key,
# only with ORACULOTO_ENV=dev; get a token with `oraculoto dev-token <invited email>`).
ORACULOTO_AUTH=dev-key
# FIREBASE_PROJECT_ID=
# Where the app keeps its own files (Google's key cache, the dev key). Default: var/ in the project.
# ORACULOTO_VAR_DIR=
# Most contests one ticket may cover (default 52).
# ORACULOTO_TICKET_MAX_SPAN=52
