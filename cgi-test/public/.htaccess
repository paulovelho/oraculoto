Options +ExecCGI -Indexes
AddHandler cgi-script .cgi
DirectoryIndex index.cgi

RewriteEngine On

# Pass the Authorization header to CGI (Apache drops it by default; Firebase tokens need it later).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Real files (test.txt) are served as they are; everything else goes to the app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.cgi [L]
